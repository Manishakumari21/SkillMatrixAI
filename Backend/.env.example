APP_NAME=SkillMatrixAI
ENVIRONMENT=development
LOG_LEVEL=INFO
ERROR_LOG_PATH=error.log
# NOTE: list values must be JSON arrays in a .env file, not comma-separated.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
DB_NAME=skillmatrix

# Must be set (no default — the app refuses to start without it).
# Generate a random one:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Both optional. Leave blank to run without any AI features — every endpoint
# degrades gracefully and returns rule-based results instead.
# Get a free key:  Groq -> https://console.groq.com/keys
#                   Gemini -> https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
PRIMARY_LLM_PROVIDER=groq
SECONDARY_LLM_PROVIDER=gemini

# ── Email (password reset) ─────────────────────────────────────────
# Leave SMTP_HOST empty in development: the reset link is then written to the
# backend log instead of emailed, so the flow still works end to end.
# Gmail: use an App Password (not your account password), not 2FA.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@skillmatrix.ai
# Public origin of the FRONTEND — the reset link points here.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30

MIN_SKILL_THRESHOLD=4
LLM_TIMEOUT_SECONDS=15
LLM_RETRY_WAIT_SECONDS=3
